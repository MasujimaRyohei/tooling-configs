{
  "name": "tooling-configs",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint, Prettier, gitignore, and tooling configs for consistent project setup.",
  "prettier": "@tooling-configs/prettier-config",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint"
  },
  "devDependencies": {
    "@tooling-configs/eslint-config": "workspace:*",
    "@tooling-configs/prettier-config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.4"
  }
}
